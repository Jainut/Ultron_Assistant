{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "rootDir": ".",
        "outDir": "dist",
        "sourceMap": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "tools/**/*.ts",
        "config/**/*.ts",
        "shared/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
